# Telegram access
# Example: 123456789:AAExampleBotTokenReplaceMe
TELEGRAM_BOT_TOKEN=

# Telegram target
# Example channel/group ID: -1001234567890
TELEGRAM_CHAT_ID=

# Incoming-message filter
TELEGRAM_USE_PREFIX_FILTER=true
TELEGRAM_COMMAND_PREFIX=cod

# Runtime state
TELEGRAM_STATE_FILE=data/state.json

# Telegram -> Codex background bridge
TELEGRAM_MONITOR_ENABLED=true
TELEGRAM_MONITOR_STATE_FILE=data/monitor-state.json
TELEGRAM_MONITOR_POLL_TIMEOUT=30
